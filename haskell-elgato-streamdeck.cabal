build-type:     Simple
tested-with:
    GHC == 9.10.3
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/bendo/haskell-elgato-streamdeck

library
  exposed-modules:
      DeviceManager
  other-modules:
      Paths_haskell_elgato_streamdeck
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.20 && <5
    , bytestring >=0.11 && <0.13
    , hidapi >=0.1.8 && <0.2
